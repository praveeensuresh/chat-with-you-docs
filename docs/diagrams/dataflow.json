  "cards": [
    {
      "dot": "cyan",
      "title": "Same model, two prefixes",
      "items": [
        "Stored text gets the prefix passage:, a question gets query:.",
        "Same model both times. Wrong prefix means worse matches."
      ]
    },
    {
      "dot": "emerald",
      "title": "Chunks and re-storing",
      "items": [
        "Chunks are 800 characters with 150 of overlap, so a split sentence stays whole.",
        "delete_by_document runs before saving, so one file is never stored twice."
      ]
    }
  ]
