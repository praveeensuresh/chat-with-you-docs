# Copy to backend/.env and fill in. Never commit the real .env.

# Claude API key. Get one at https://console.anthropic.com (pay-as-you-go).
ANTHROPIC_API_KEY=

# Qdrant (ADR-0002).
# Dev: local docker (docker compose up -d) -> http://localhost:6333
# Demo: your Qdrant Cloud cluster URL + key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Embedding model (ADR-0001). Self-hosted, loaded in-process.
EMBEDDING_MODEL=intfloat/e5-base
